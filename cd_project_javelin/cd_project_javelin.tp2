      LPF DELETE_CRE_ITEM STR_VAR item_to_delete = arow09 END
      ADD_CRE_ITEM ~cdjav2e~ #0 #0 #0 ~NONE~ ~weapon~
      LPF cd_transfer_profs INT_VAR old_bg1 = 0x70 old_bg2 = 104 new_bg1 = 0x71 new_bg2 = 98 END // any prof with bow, set to spear (if lower)
      BUT_ONLY
    
    COPY_EXISTING ~bd5300.are~ ~override~ // give to skelly archer in kanaglym
      READ_LONG  0x54 actor_off
