          WRITE_ASCII (actor_off + 0x80 + (index * 0x110)) ~cdskgr04~ #8
          SET index = actor_num // kill loop
        END
      END
      BUT_ONLY       
          
  
  END */
    
END 

ACTION_IF game_includes_soa BEGIN // bg2ee, eet, bgt, obg2
  
  COPY_EXISTING ~ribald.sto~ ~override~ // add +2 returning to adventurer's mart
    LPF ADD_STORE_ITEM_EX STR_VAR item_name = cdjav2 position = EVAL "AFTER sper05" flags = identified END
    BUT_ONLY

  // add evergreen +3 to the wyvern cultist in the north forest
  COPY_EXISTING ~wyvfight.cre~ ~override~
    LPF DELETE_CRE_ITEM STR_VAR item_to_delete = sper05 END // remove +2 spear
    ADD_CRE_ITEM ~cdjav3e~ #0 #0 #0 ~NONE~ ~weapon~ EQUIP
    READ_LONG 0x2b8 slot_off
    WRITE_SHORT (slot_off + 0x4e) 1 // set javelin to melee ability
    BUT_ONLY

  COMPILE ~cd_project_javelin/dlg/cromwell.d~ // upgrade evergreen +3 to +4 [cromwell]
  EXTEND_BOTTOM ~ar0334.bcs~ ~cd_project_javelin/baf/ar0334.baf~

  ACTION_IF game_includes_tob BEGIN // bg2ee, eet, bgt, obg2

    COMPILE ~cd_project_javelin/dlg/cespenar.d~ // upgrade evergreen +3 to +4 [cespenar]
    EXTEND_BOTTOM ~botsmith.bcs~ ~cd_project_javelin/baf/botsmith.baf~

  END
  
END 

/* basic logic for placing low-level javelins in stores: 
- skip if the store doesn't sell basic spears (sper01)
- if a store sells throwing daggers or axes (dagg05), add basic javelins
- if a store also sells +1 daggers/axes/spears, add +1 javelins
- if they also sell poisoned ammo, sell poisoned spears
- if they also sell fire ammo, sell fire spears
*/

COPY_EXISTING_REGEXP GLOB ~^.+\.sto$~ ~override~
  READ_LONG 0x08 type
  PATCH_IF type != 5 BEGIN // not a bag
    SET spear = 0
    SET jav0  = 0
    SET jav1  = 0
    SET jav1p = 0
    SET jav1b = 0
    SPRINT lspear ~~
    READ_LONG 0x34 sale_off
    READ_LONG 0x38 sale_num
    FOR (index = 0 ; index < sale_num ; ++index) BEGIN 
      READ_ASCII (sale_off + 0x00 + (index * 0x1c)) item
      PATCH_IF ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Ss][Pp][Ee][Rr]01$" = 0) BEGIN // spear 
        SET spear = 1
        SPRINT lspear ~%item%~
      END ELSE  
      PATCH_IF (("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Dd][Aa][Gg][Gg]05$" = 0) OR  // throwing dagger 
                ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Aa][Xx]1[Hh]04$" = 0)) BEGIN // throwing axe
        SET jav0 = 1
        READ_LONG  (sale_off + 0x14 + (index * 0x1c)) jav0q
        READ_LONG  (sale_off + 0x18 + (index * 0x1c)) jav0i
      END ELSE  
      PATCH_IF ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Ss][Pp][Ee][Rr]02$" = 0) BEGIN  // spear +1
        SET jav1 = 1
        SPRINT lspear ~%item%~
      END ELSE  
      PATCH_IF (("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Dd][Aa][Gg][Gg]02$" = 0) OR  // dagger +1
                ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Aa][Xx]1[Hh]02$" = 0)) BEGIN // axe +1
        SET jav1 = 1
      END ELSE  
      PATCH_IF (("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Dd][Aa][Gg][Gg]16$" = 0) OR      // poisoned throwing daggers
                ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Aa][Rr][Oo][Ww]05$" = 0) OR      // arrow of biting
                ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Bb][Oo][Ll][Tt]04$" = 0) OR      // bolt of biting
                ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Dd][Aa][Rr][Tt]05$$" = 0)) BEGIN // asp's nest
        SET jav1p = 1
      END ELSE  
      PATCH_IF (("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Aa][Rr][Oo][Ww]08$" = 0) OR        // arrow of fire
                ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Bb][Uu][Ll][Ll]0[47]$" = 0)) BEGIN // sunstone/fire bullet
        SET jav1b = 1
      END ELSE  
      PATCH_IF ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Ss][Pp][Ee][Rr][0-9]+$" = 0) BEGIN  // any spear (for placement)
        SPRINT lspear ~%item%~
      END   
    END 
    //PATCH_PRINT ~ %SOURCE_FILE%: spear %spear%, jav0 %jav0%, jav1 %jav1%, jav1p %jav1p%~
    PATCH_IF spear AND jav0 BEGIN 
      LPF ADD_STORE_ITEM_EX INT_VAR charge1 = 20 stack = jav0q unlimited = jav0i STR_VAR item_name = cdjav0 position = EVAL "AFTER %lspear%" flags = identified END
      PATCH_IF jav1p BEGIN 
        LPF ADD_STORE_ITEM_EX INT_VAR charge1 = 2 stack = 5 unlimited = 0 STR_VAR item_name = cdjav1p position = "AFTER cdjav0" flags = identified END
      END   
      PATCH_IF jav1b BEGIN 
        LPF ADD_STORE_ITEM_EX INT_VAR charge1 = 2 stack = 5 unlimited = 0 STR_VAR item_name = cdjav1b position = "AFTER cdjav0" flags = identified END
      END   
      PATCH_IF jav1 BEGIN 
        LPF ADD_STORE_ITEM_EX INT_VAR charge1 = 5 stack = 5 unlimited = 0 STR_VAR item_name = cdjav1 position = "AFTER cdjav0" flags = identified END
      END  
    END  
  END
  BUT_ONLY

/* basic logic for javelins-as-loot on a per-container basis: 
if one of these items is found, chance to add an identical stack of javelins:
 - throwing axes, throwing daggers: 2x chance of basic javelin stack (secondary roll of d20; 20 = high quality stack instead)
 - arrows, bolts, bullets: chance of basic javelin stack (if 3% pass, secondary roll of d20; 20 = high quality stack instead)
 - +1 arrows, bolts, bullets: chance of +1 javelin stack
 - fire arrows, fire/sunstone bullets: chance of +1 fire javelin
 - asp's nest, poisoned throwing daggers, arrows/bolts of biting: chance of +1 poison javelin
*/

COPY_EXISTING_REGEXP GLOB ~^.+\.are$~ ~override~
  READ_LONG  0x70 cont_off
  READ_SHORT 0x74 cont_num
  READ_SHORT 0x78 item_off
  SET item_delta = 0
  FOR (index = 0 ; index < cont_num ; ++index) BEGIN 
    SET jav0  = 0
    SET jav1  = 0
    SET jav1b = 0
    SET jav1p = 0
    SET local_delta = 0
    CLEAR_ARRAY cd_new_javs
    WRITE_LONG (cont_off + 0x40 + (index * 0xc0)) (THIS + item_delta) // update index if we've inserted items
    READ_LONG (cont_off + 0x40 + (index * 0xc0)) item_idx
    READ_LONG (cont_off + 0x44 + (index * 0xc0)) item_num
    FOR (index2 = item_idx ; index2 < (item_idx + item_num) ; ++index2) BEGIN
      READ_ASCII (item_off + 0x00 + (index2 * 0x14)) item
      PATCH_IF  (("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Dd][Aa][Gg][Gg]05$" = 0) OR  // throwing dagger 
                 ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Aa][Xx]1[Hh]04$" = 0)) BEGIN // throwing axe
        SET check = RANDOM (1 100)
        PATCH_IF check <= (2 * base_chance) BEGIN 
          SET check = RANDOM (1 20)
          PATCH_IF check = 20 BEGIN SPRINT nitem cdjav0q END ELSE BEGIN SPRINT nitem cdjav0 END
          DEFINE_ASSOCIATIVE_ARRAY cd_new_javs BEGIN ~%index2%~ => ~%nitem%~ END 
        END   
      END ELSE         
      PATCH_IF (("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Aa][Rr][Oo][Ww]01$" = 0) OR     // generic arrow 
                ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Bb][Oo][Ll][Tt]01$" = 0) OR     // generic bolt
                ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Bb][Uu][Ll][Ll]01$" = 0)) BEGIN // generic bullet
        SET check = RANDOM (1 100)
        PATCH_IF check <= base_chance BEGIN 
          SET check = RANDOM (1 20)
          PATCH_IF check = 20 BEGIN SPRINT nitem cdjav0q END ELSE BEGIN SPRINT nitem cdjav0 END
          DEFINE_ASSOCIATIVE_ARRAY cd_new_javs BEGIN ~%index2%~ => ~%nitem%~ END 
        END   
      END ELSE             
      PATCH_IF (("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Aa][Rr][Oo][Ww]02$" = 0) OR     // +1 arrow 
                ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Bb][Oo][Ll][Tt]02$" = 0) OR     // +1 bolt
                ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Bb][Uu][Ll][Ll]03$" = 0)) BEGIN // +1 bullet
        SET check = RANDOM (1 100)
        PATCH_IF check <= base_chance BEGIN 
          DEFINE_ASSOCIATIVE_ARRAY cd_new_javs BEGIN ~%index2%~ => ~cdjav0~ END 
        END   
      END ELSE         
      PATCH_IF (("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Dd][Aa][Gg][Gg]16$" = 0) OR      // poisoned throwing daggers
                ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Aa][Rr][Oo][Ww]05$" = 0) OR      // arrow of biting
                ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Bb][Oo][Ll][Tt]04$" = 0) OR      // bolt of biting
                ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Dd][Aa][Rr][Tt]05$$" = 0)) BEGIN // asp's nest
        SET check = RANDOM (1 100)
        PATCH_IF check <= base_chance BEGIN 
          DEFINE_ASSOCIATIVE_ARRAY cd_new_javs BEGIN ~%index2%~ => ~cdjav1p~ END 
        END   
      END ELSE          
      PATCH_IF (("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Aa][Rr][Oo][Ww]08$" = 0) OR        // arrow of fire
                ("%item%" STRING_COMPARE_REGEXP "^%tutu_var%[Bb][Uu][Ll][Ll]0[47]$" = 0)) BEGIN // sunstone/fire bullet
        SET check = RANDOM (1 100)
        PATCH_IF check <= base_chance BEGIN 
          DEFINE_ASSOCIATIVE_ARRAY cd_new_javs BEGIN ~%index2%~ => ~cdjav1b~ END 
        END   
      END
    END // done looking through items
    PATCH_PHP_EACH cd_new_javs AS idx => nitem BEGIN
      //PATCH_PRINT ~ array: %nitem%, %idx% on %SOURCE_FILE%, container %index%~
      READ_ASCII   (item_off + 0x00 + ((idx + local_delta) * 0x14)) template (20)
      INSERT_BYTES (item_off + 0x00 + ((idx + local_delta) * 0x14)) 0x14
      WRITE_ASCIIE (item_off + 0x00 + ((idx + local_delta) * 0x14)) ~%template%~ #20
      WRITE_ASCIIE (item_off + 0x00 + ((idx + local_delta) * 0x14)) ~%nitem%~ #8
      READ_SHORT   (item_off + 0x0a + ((idx + local_delta) * 0x14)) count
      PATCH_IF count > jav_stack BEGIN // since arrows et al have higher stacks check quantity
        WRITE_SHORT   (item_off + 0x0a + ((idx + local_delta) * 0x14)) jav_stack
      END   
      SET local_delta += 1
      SET item_delta  += 1
    END   
    WRITE_LONG (cont_off + 0x44 + (index * 0xc0)) item_num + local_delta
  END // cont loop
  PATCH_IF item_delta BEGIN
    PATCH_FOR_EACH offset IN 0x54 0x5c 0x60 0x64 0x68 0x70 /* 0x78 */ 0x7c 0x84 0x88 0x90 0xa0 0xa8 0xb0 0xb8 0xbc 0xc0 0xc4 0xcc BEGIN
      READ_LONG offset off
      PATCH_IF off > item_off BEGIN 
        WRITE_LONG offset (THIS + (0x14 * item_delta))
      END
    END
  END
  BUT_ONLY  

/////                                                  \\\\\
///// PFNM updates                                     \\\\\
/////                                                  \\\\\

// bgee/bg2ee/eet PFNM already blocks spears, so use spear value to clone - use axes for everything else
ACTION_IF game_is_bgee OR game_is_bg2ee OR game_is_eet BEGIN OUTER_SET projmatch = 55 END ELSE BEGIN OUTER_SET projmatch = 9 END
COPY_EXISTING_REGEXP GLOB ~^.+\.\(cre\|itm\|spl\)$~ ~override~
  READ_ASCII 0x00 type (3)
  SET min_size = 0
  PATCH_IF ("%type%" STRING_COMPARE_CASE "spl" = 0) BEGIN
    READ_LONG  0x64 abil_off ELSE 0
    READ_SHORT 0x68 abil_num ELSE 0
    READ_LONG  0x6a fx_off   ELSE 0
    SET counter_offset = 0x70
    SET abil_length    = 0x28
    SET global_loop    = 0
    SET fx_type        = 0
    SET min_size       = 0x72
  END ELSE
  PATCH_IF ("%type%" STRING_COMPARE_CASE "itm" = 0) BEGIN
    READ_LONG  0x64 abil_off ELSE 0
    READ_SHORT 0x68 abil_num ELSE 0
    READ_LONG  0x6a fx_off   ELSE 0
    SET counter_offset = 0x70
    SET abil_length    = 0x38
    SET global_loop    = 1
    SET fx_type        = 0
    SET min_size       = 0x72
  END ELSE
  PATCH_IF ("%type%" STRING_COMPARE_CASE "cre" = 0) BEGIN
    READ_LONG  0x2c4 fx_off ELSE 0
    READ_BYTE 0x33 fx_type ELSE 2
    SET abil_off       = 0
    SET abil_num       = 0
    SET counter_offset = 0x2c8
    SET abil_length    = 0
    SET global_loop    = 1
    SET min_size       = 0x2d4
  END ELSE BEGIN
    PATCH_PRINT ~Warning: PFNM update halting; file type not recognized (%type%)~
  END
  PATCH_IF ((SOURCE_SIZE >= min_size) AND (min_size != 0)) BEGIN // min_size must get set by file type detection
    SET new_fx = 0
    FOR (index = (0 - global_loop) ; index < abil_num ; ++index) BEGIN
      PATCH_IF (index < 0) BEGIN // if loop through globals needed
        SET abil_fx_idx = 0
      END ELSE BEGIN // otherwise normal ability
        SET counter_offset = (abil_off + 0x1e + (abil_length * index))
        READ_SHORT  (abil_off + 0x20 + (abil_length * index)) abil_fx_idx
        SET abil_fx_idx += new_fx
        WRITE_SHORT (abil_off + 0x20 + (abil_length * index)) (abil_fx_idx)
      END
      READ_SHORT counter_offset counter // fx_num on global loop, otherwise abil_fx_num
      FOR (index2 = 0 ; index2 < counter ; ++index2) BEGIN
        READ_SHORT (fx_off        + (0x08 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) opcode
        READ_LONG  (fx_off + 0x08 + (0x10 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) param2
        PATCH_IF (((opcode = 83) OR (opcode = 197)) AND (param2 = projmatch)) BEGIN // protection from or bounce projectile
          READ_ASCII (fx_off + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) template ((0x30 + (0xd8 * fx_type)))                  // read whole effect into a template
          INSERT_BYTES (fx_off        + (0x08 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) (0x30 + (0xd8 * fx_type)) // insert effect
          WRITE_ASCIIE (fx_off        + (0x08 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) "%template%"              // clones from template
          WRITE_LONG   (fx_off + 0x08 + (0x10 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) (cdjav0q_proj - 1)        // update projectile to HQ javelin
          INSERT_BYTES (fx_off        + (0x08 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) (0x30 + (0xd8 * fx_type)) // insert effect
          WRITE_ASCIIE (fx_off        + (0x08 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) "%template%"              // clones from template
          WRITE_LONG   (fx_off + 0x08 + (0x10 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) (cdjav0_proj - 1)         // update projectile to basic javelin
          SET new_fx  += 2
          SET counter += 2
          SET index2  += 2
        END
      END 
      WRITE_SHORT counter_offset counter
    END

    PATCH_IF ((min_size = 0x2d4) AND (new_fx > 0)) BEGIN // fix offsets for cre files if fx inserted
      PATCH_FOR_EACH offset IN 0x2a0 0x2a8 0x2b0 0x2b8 0x2bc BEGIN
        READ_LONG offset curr_off
        PATCH_IF (fx_off < curr_off) BEGIN
          WRITE_LONG offset (THIS + ((0x30 + (0xd8 * fx_type)) * new_fx))
        END
      END
    END

  END // end file size check
  BUT_ONLY
