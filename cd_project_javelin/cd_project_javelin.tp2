BACKUP ~weidu_external/cd_project_javelin/backup~
SUPPORT ~https://www.gibberlings3.net/forums/forum/28-miscellaneous-released-mods/~

VERSION ~Beta 1~

README ~cd_project_javelin/lang/%LANGUAGE%/readme-cd_project_javelin.html~ ~cd_project_javelin/readme-cd_project_javelin.html~

ALWAYS 

  ACTION_IF ((FILE_EXISTS ~dlc/sod-dlc.zip~) OR (FILE_EXISTS ~sod-dlc.zip~)) THEN BEGIN FAIL @1 END // DLC Merger check
  
  ACTION_IF !VARIABLE_IS_SET cd_project_javelin_always BEGIN 
  
    OUTER_SET cd_project_javelin_always = 1
    INCLUDE ~cd_project_javelin/lib/functions.tpa~ // mod-specific macros and functions

    ACTION_IF enhanced_edition BEGIN // ee games
    
      OUTER_SET silence_immunity   = IDS_OF_SYMBOL (~splstate~ ~SILENCE_IMMUNITY~) // eefp
      OUTER_SET 50sonic_immunity   = IDS_OF_SYMBOL (~splstate~ ~50_PERCENT_SONIC_IMMUNITY~) // iwdee bard songs via iwdee/iwdification/scs/et al

      OUTER_SPRINT ~tra_location~ ~cd_project_javelin/lang~

    END ELSE BEGIN

      OUTER_SET silence_immunity   = "-1"
      OUTER_SET 50sonic_immunity   = "-1"
      
      OUTER_SPRINT ~tra_location~ ~weidu_external/cd_project_javelin/lang~

      // convert strings from UTF-8 for originals
      ACTION_DEFINE_ARRAY cdnoconvert BEGIN weidu orig END
      ACTION_DEFINE_ARRAY cdreload BEGIN game END
      LAF HANDLE_CHARSETS INT_VAR from_utf8 = 1 infer_charsets = 1
                          STR_VAR default_language = ~en_us~ tra_path = ~cd_project_javelin/lang~ out_path = ~weidu_external/cd_project_javelin/lang~ noconvert_array = cdnoconvert reload_array = cdreload END

  
      LOAD_TRA ~cd_project_javelin/lang/%LANGUAGE%/orig.tra~
    END
    
  END // always var check  
  
END

AUTO_TRA ~%tra_location%/%s~

LANGUAGE
  ~English~
  ~en_us~
  ~cd_project_javelin/lang/en_us/game.tra~
  ~cd_project_javelin/lang/en_us/weidu.tra~

/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// javelins                                         \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

BEGIN @0 DESIGNATED 1
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet iwdee bgt bg2 tob tutu tutu_totsc~ @2
LABEL ~cd_project_javelin~

/////                                                  \\\\\
///// set baseline data                                \\\\\
/////                                                  \\\\\

// base chance is used as a d100 threshold to clone ammo in containers (arrows, bolts, throwing daggers, &c.) into low-level javelins
OUTER_SET base_chance = 5

// basic stack size for javelins; also used 
ACTION_IF MOD_IS_INSTALLED ~cdtweaks.tp2~ ~3080~ BEGIN OUTER_SET jav_stack = 999 END ELSE // anthology's various ammo stack increase components
ACTION_IF MOD_IS_INSTALLED ~cdtweaks.tp2~ ~3081~ BEGIN OUTER_SET jav_stack =  40 END ELSE  
ACTION_IF MOD_IS_INSTALLED ~cdtweaks.tp2~ ~3082~ BEGIN OUTER_SET jav_stack =  80 END ELSE 
ACTION_IF MOD_IS_INSTALLED ~cdtweaks.tp2~ ~3083~ BEGIN OUTER_SET jav_stack = 120 END ELSE 
                                                 BEGIN OUTER_SET jav_stack =  20 END      // otherwise just use 20

// if a mod increases spear damage, use those as baseline - used in item descripts and set in base javelin so it propagates
ACTION_IF ((MOD_IS_INSTALLED ~zstweaks.tp2~ ~1150~) OR 
           (MOD_IS_INSTALLED ~zstweaks.tp2~ ~103~) OR
           (MOD_IS_INSTALLED ~iwdification.tp2~ ~190~)) BEGIN // Make spears do a baseline damage of 1d8, not 1d6 
  OUTER_SET melee_die  = 6
  OUTER_SET ranged_die = 8
END ELSE BEGIN  
  OUTER_SET melee_die  = 4
  OUTER_SET ranged_die = 6
END 

/////                                                  \\\\\
///// animations                                       \\\\\
/////                                                  \\\\\
      
COPY ~cd_project_javelin/anim/wqlspa1.bam~ ~override~             // 1h spear overhead (ranged) animation, large [human]
     ~cd_project_javelin/anim/wqlspa5.bam~ ~override~             // 1h spear thrust (melee) animation, large [human]
     ~cd_project_javelin/anim/wqlspa1.bam~ ~override/wqnspa1.bam~ // 1h spear overhead (ranged) animation, large [unk]
     ~cd_project_javelin/anim/wqlspa5.bam~ ~override/wqnspa5.bam~ // 1h spear thrust (melee) animation, large [unk]
     ~cd_project_javelin/anim/wqmspa1.bam~ ~override~             // 1h spear overhead (ranged) animation, large [elf]
     ~cd_project_javelin/anim/wqmspa5.bam~ ~override~             // 1h spear thrust (melee) animation, large [elf]
     ~cd_project_javelin/anim/wqsspa1.bam~ ~override~             // 1h spear overhead (ranged) animation, large [dwarf]
     ~cd_project_javelin/anim/wqsspa5.bam~ ~override~             // 1h spear thrust (melee) animation, large [dwarf]

/////                                                  \\\\\
///// proficiency description update                   \\\\\
/////                                                  \\\\\

// add javelin mention to existing spear proficiency description string
COPY_EXISTING - ~weapprof.2da~ ~override~ // get string from weapprof
  REPLACE_EVALUATE ~^\(SPEAR[ %TAB%]+[0-9][0-9]+[ %TAB%]+[0-9]+[ %TAB%]+\)\([0-9]+\)~ BEGIN
    SET spear_strref = MATCH2
  END ~%MATCH1%%MATCH2%~
  
ACTION_IF VARIABLE_IS_SET spear_strref BEGIN // sanity check

  OUTER_SPRINT jav_desc @1025
  ACTION_GET_STRREF spear_strref desc
  OUTER_INNER_PATCH_SAVE desc ~%desc%~ BEGIN
    REPLACE_TEXTUALLY ~\([ %TAB%%LNL%%MNL%]+<DOTS1>\)~ ~ %jav_desc%\1~
  END
  STRING_SET_EVALUATE spear_strref ~%desc%~

END

/////                                                  \\\\\
///// making the items                                 \\\\\
/////                                                  \\\\\

// basic +0 javelin, will be used as a base for other items
LAF cd_spear_ancillary STR_VAR name = cdjav0 RET cdjav0_proj = proj END // copies BAMs, makes projectile, appends tooltip
COPY ~cd_project_javelin/itm/cdjav0.itm~ ~override~
  SAY 0x08 @1000
  SAY 0x0c @1000
  SAY 0x50 @1001
  WRITE_SHORT 0x38 jav_stack
  LPF ALTER_HEADER INT_VAR match_type = 2 projectile = cdjav0_proj 
    flag_strength = (1 - enhanced_edition) flag_str_damage = enhanced_edition END // use BIT0 on oBG2, BIT2 on EEs

// make high quality javelin from basic javelin
LAF cd_spear_ancillary STR_VAR name = cdjav0q RET cdjav0q_proj = proj END // copies BAMs, makes projectile, appends tooltip
COPY_EXISTING ~cdjav0.itm~ ~override/cdjav0q.itm~
  SAY 0x08 @1014
  SAY 0x0c @1014
  SAY 0x50 @1015
  LPF cd_spear_edits INT_VAR color1 = 15 color2 = 26 thac0_adj = 1 weight = 3 price = 5 proj = cdjav0q_proj STR_VAR name = EVAL ~%DEST_RES%~ END 

// make javelin +1 from basic javelin
LAF cd_spear_ancillary STR_VAR name = cdjav1 RET proj END // copies BAMs, makes projectile, appends tooltip
COPY_EXISTING ~cdjav0.itm~ ~override/cdjav1.itm~
  SAY 0x0c @1002
  SAY 0x54 @1003
  LPF cd_spear_edits INT_VAR lore = 20 color1 = 67 color2 = 63 enchantment = 1 weight = 2 price = 10 proj STR_VAR name = EVAL ~%DEST_RES%~ cicon = csper07 END 

// make burning Javelin +1 from basic javelin
LAF cd_spear_ancillary STR_VAR name = cdjav1b RET proj END // copies BAMs, makes projectile, appends tooltip
COPY_EXISTING ~cdjav0.itm~ ~override/cdjav1b.itm~
  SAY 0x0c @1019
  SAY 0x54 @1020
  LPF cd_spear_edits INT_VAR lore = 25 color1 = 80 color2 = 94 enchantment = 1 weight = 2 price = 25 proj STR_VAR name = EVAL ~%DEST_RES%~ cicon = csper02 END 
  // fire effects
  LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 9 target = 2 parameter1 = (64 << 8) parameter2 = (21 + (20 << 16)) timing = 2 END // glowing spearhead (64 red 0 g/b)
  LPF ADD_ITEM_EFFECT INT_VAR type = 99 opcode = 12 target = 2 parameter2 = (8 << 16) resist_dispel = 1 timing = 1 savingthrow = BIT0 dicenumber = 1 dicesize = 4 END // 1d4 fire
  PATCH_IF enhanced_edition BEGIN 
    LPF ADD_ITEM_EFFECT INT_VAR type = 99 insert_point = 0 opcode = 324 target = 2 parameter2 = 3 resist_dispel = 2 STR_VAR resource = EVAL ~%DEST_RES%~ END // fire immunity
  END   

// make Poisoned Javelin +1 from basic javelin
LAF cd_spear_ancillary STR_VAR name = cdjav1p RET proj END // copies BAMs, makes projectile, appends tooltip
COPY_EXISTING ~cdjav0.itm~ ~override/cdjav1p.itm~
  SAY 0x0c @1004
  SAY 0x54 @1005
  LPF cd_spear_edits INT_VAR lore = 30 color1 = 7 color2 = 5 enchantment = 1 weight = 2 price = 30 proj STR_VAR name = EVAL ~%DEST_RES%~ cicon = csper07 END 
  // now add poison effects
  LPF ADD_ITEM_EFFECT INT_VAR type = 99 opcode = 25 target = 2 parameter1 = 2 parameter2 = 2 resist_dispel = 2 duration = 10 savingthrow = BIT2 END // poison
  PATCH_IF enhanced_edition BEGIN 
    LPF ALTER_EFFECT INT_VAR match_opcode = 25 special = 6 END // attach poison icon directly to poison effect
    LPF ADD_ITEM_EFFECT INT_VAR type = 99 insert_point = 0 opcode = 324 target = 2 parameter2 = 55 resist_dispel = 2 STR_VAR resource = EVAL ~%DEST_RES%~ END // golem immunity
    LPF ADD_ITEM_EFFECT INT_VAR type = 99 insert_point = 0 opcode = 324 target = 2 parameter2 = 77 resist_dispel = 2 STR_VAR resource = EVAL ~%DEST_RES%~ END // poison immunity
  END ELSE BEGIN 
    LPF ADD_ITEM_EFFECT INT_VAR type = 99 opcode = 142 target = 2 parameter2 = 6 resist_dispel = 2 duration = 10 savingthrow = BIT2 END // poison icon
  END   

// make Returning Javelin +2 from basic javelin
LAF cd_spear_ancillary STR_VAR name = cdjav2 RET proj END // copies BAMs, makes projectile, appends tooltip
COPY_EXISTING ~cdjav0.itm~ ~override/cdjav2.itm~
  SAY 0x0c @1006
  SAY 0x54 @1007
  LPF cd_spear_edits INT_VAR lore = 40 color1 = 68 color2 = 64 enchantment = 2 weight = 2 price = 2500 returning = 1 proj STR_VAR name = EVAL ~%DEST_RES%~ cicon = csper02 END 
  
// make iron elegy +2 from basic javelin
LAF cd_spear_ancillary INT_VAR proj_spd = 30 STR_VAR name = cdjav2e RET proj END // copies BAMs, makes projectile, appends tooltip
COPY_EXISTING ~cdjav0.itm~ ~override/cdjav2e.itm~
  SAY 0x0c @1016
  SAY 0x54 @1017
  LPF cd_spear_edits INT_VAR lore = 45 color1 = 79 color2 = 93 enchantment = 2 weight = 15 price = 5000 returning = 1 proj STR_VAR name = EVAL ~%DEST_RES%~ cicon = csper07 END 
  WRITE_SHORT 0x26 12 // min str
  // 10% silence on hit
  LPF ADD_ITEM_EFFECT INT_VAR type = 99 opcode =  38 target = 2 timing = 0 duration = 12 resist_dispel = 1 probability1 = 9 savingthrow = BIT0 END // silence
  LPF ADD_ITEM_EFFECT INT_VAR type = 99 opcode = 142 target = 2 parameter2 = 34 timing = 0 duration = 12 resist_dispel = 1 probability1 = 9 savingthrow = BIT0 END // silence icon
  LPF ADD_ITEM_EFFECT INT_VAR type = 99 opcode = 174 target = 2 timing = 4 duration = 12 resist_dispel = 1 probability1 = 9 savingthrow = BIT0 STR_VAR resource = eff_e06 END // expiry sound
  LPF ADD_ITEM_EFFECT INT_VAR type = 99 opcode = 139 target = 2 parameter1 = RESOLVE_STR_REF(@1018) timing = 1 resist_dispel = 1 probability1 = 9 savingthrow = BIT0 END // string
  PATCH_IF !enhanced_edition BEGIN 
    LPF ADD_ITEM_EFFECT INT_VAR type = 99 opcode = 215 target = 2 timing = 0 duration = 3 resist_dispel = 1 probability1 = 9 savingthrow = BIT0 STR_VAR resource = sph1hi01 END // visual
    LPF ADD_ITEM_EFFECT INT_VAR type = 99 opcode = 215 target = 2 timing = 0 duration = 3 resist_dispel = 1 probability1 = 9 savingthrow = BIT0 STR_VAR resource = sphlhi02 END // visual
  END ELSE BEGIN  
    LPF ADD_ITEM_EFFECT INT_VAR type = 99 opcode = 177 target = 2 parameter1 = 5 parameter2 = 5 timing = 1 resist_dispel = 1 probability1 = 9 savingthrow = BIT0 STR_VAR resource = bardsil END // bard song silenced
    PATCH_IF !game_is_iwdee BEGIN // bgee, bg2ee, eet
      LPF ADD_ITEM_EFFECT INT_VAR type = 99 opcode = 174 target = 2 timing = 1 resist_dispel = 1 probability1 = 9 savingthrow = BIT0 STR_VAR resource = eff_m58 END // sound
      LPF ADD_ITEM_EFFECT INT_VAR type = 99 opcode = 141 target = 2 parameter2 = 6 timing = 1 resist_dispel = 1 probability1 = 9 savingthrow = BIT0 END // lighting
    END ELSE BEGIN  
      LPF ADD_ITEM_EFFECT INT_VAR type = 99 opcode = 174 target = 2 timing = 1 resist_dispel = 1 probability1 = 9 savingthrow = BIT0 STR_VAR resource = ~#eff_p07~ END // sound
      LPF ALTER_EFFECT INT_VAR match_opcode = 174 match_timing = 4 STR_VAR resource = ~#eff_e05~ END // different sounds for iwdee    
      LPF ADD_ITEM_EFFECT INT_VAR type = 99 opcode = 215 target = 2 timing = 1 resist_dispel = 1 probability1 = 9 savingthrow = BIT0 STR_VAR resource = alterh END // visual
    END
    PATCH_IF silence_immunity > 0 BEGIN // if silence_immunity is a spell state
      LPF ADD_ITEM_EFFECT INT_VAR type = 99 insert_point = 0 opcode = 324 target = 2 parameter1 = silence_immunity parameter2 = 110 resist_dispel = 1 probability1 = 9 STR_VAR resource = EVAL ~%DEST_RES%~ END // silence immunity
    END  
    PATCH_IF 50sonic_immunity > 0 BEGIN // if 50% sonic immunty (IWD bard song)
      LPF ADD_ITEM_EFFECT INT_VAR type = 99 insert_point = 0 opcode = 324 target = 2 parameter1 = 50sonic_immunity parameter2 = 110 resist_dispel = 1 probability1 = 4 STR_VAR resource = EVAL ~%DEST_RES%~ END // silence immunity
    END
  END 

// make Returning Javelin +3 from basic javelin
LAF cd_spear_ancillary STR_VAR name = cdjav3 RET proj END // copies BAMs, makes projectile, appends tooltip
COPY_EXISTING ~cdjav0.itm~ ~override/cdjav3.itm~
  SAY 0x0c @1008
  SAY 0x54 @1009
  LPF cd_spear_edits INT_VAR lore = 50 color1 = 44 color2 = 22 enchantment = 3 weight = 2 price = 6000 returning = 1 proj STR_VAR name = EVAL ~%DEST_RES%~ cicon = csper02 END 

// make Evergreen Javelin +3 from basic javelin
LAF cd_spear_ancillary STR_VAR name = cdjav3e RET proj END // copies BAMs, makes projectile, appends tooltip
COPY_EXISTING ~cdjav0.itm~ ~override/cdjav3e.itm~
  SAY 0x0c @1010
  SAY 0x54 @1011
  LPF cd_spear_edits INT_VAR lore = 65 color1 = 7 color2 = 36 enchantment = 3 weight = 2 price = 9500 returning = 1 proj STR_VAR name = EVAL ~%DEST_RES%~ cicon = csper03 END

// make Evergreen Javelin +4 from basic javelin
LAF cd_spear_ancillary STR_VAR name = cdjav4e RET proj END // copies BAMs, makes projectile, appends tooltip
COPY_EXISTING ~cdjav0.itm~ ~override/cdjav4e.itm~
  SAY 0x0c @1012
  SAY 0x54 @1013
  LPF cd_spear_edits INT_VAR color1 = 52 color2 = 90 enchantment = 4 weight = 2 price = 17000 returning = 1 proj STR_VAR name = EVAL ~%DEST_RES%~ cicon = csper03 END

// outerplanar damage for evergreen
COPY ~cd_project_javelin/wav/cdjav3e.wav~  ~override~       // quad damage sound - not worth to convert for one file
COPY ~cd_project_javelin/eff/cdjav3e.eff~  ~override~       // eff to play sound
COPY ~cd_project_javelin/eff/cdjav3e0.eff~ ~override~       // +3 melee double
  WRITE_LONG 0x3c melee_die   // base die size
COPY_EXISTING ~cdjav3e0.eff~ ~override/cdjav3e2.eff~ // +3 ranged double
  WRITE_SHORT 0x22 128        // damage type: missile
  WRITE_LONG  0x3c ranged_die // base die size
COPY_EXISTING ~cdjav3e0.eff~ ~override/cdjav4e0.eff~ // +4 melee double
              ~cdjav3e2.eff~ ~override/cdjav4e2.eff~ // +4 ranged double
  WRITE_LONG 0x1c 4 // +3 > +4 fixed damage
COPY_EXISTING ~cdjav3e0.eff~ ~override/cdjav3e1.eff~ // +3 melee quadruple
              ~cdjav3e2.eff~ ~override/cdjav3e3.eff~ // +3 melee quadruple
              ~cdjav4e0.eff~ ~override/cdjav4e1.eff~ // +4 melee quadruple
              ~cdjav4e2.eff~ ~override/cdjav4e3.eff~ // +4 melee quadruple
  WRITE_LONG 0x1c (THIS * 3) // +3 > +9 OR +4 > +12 fixed damage
  WRITE_LONG 0x38 (THIS * 3) // 1dX to 3dX

OUTER_SET prob = 4
COPY_EXISTING ~cdjav3e.itm~ ~override~
              ~cdjav4e.itm~ ~override~
  // races: demonic, rakshasha, mephit, elemental, genie, githyanki, (anti)solar, (dark) planetar, salamander
  PATCH_FOR_EACH race IN 121 128 139 145 147 152 156 157 158 159 169 BEGIN 
    LPF ADD_ITEM_EFFECT INT_VAR type = 1 opcode = 177 target = 2 parameter1 = race parameter2 = 4 timing = 1 probability1 = prob       STR_VAR resource = cdjav3e              END // melee quadruple sound
    LPF ADD_ITEM_EFFECT INT_VAR type = 1 opcode = 177 target = 2 parameter1 = race parameter2 = 4 timing = 1 probability1 = prob       STR_VAR resource = EVAL ~%SOURCE_RES%1~ END // melee quadruple
    LPF ADD_ITEM_EFFECT INT_VAR type = 1 opcode = 177 target = 2 parameter1 = race parameter2 = 4 timing = 1 probability2 = (1 + prob) STR_VAR resource = EVAL ~%SOURCE_RES%0~ END // melee double
    LPF ADD_ITEM_EFFECT INT_VAR type = 2 opcode = 177 target = 2 parameter1 = race parameter2 = 4 timing = 1 probability1 = prob       STR_VAR resource = cdjav3e              END // ranged quadruple sound
    LPF ADD_ITEM_EFFECT INT_VAR type = 2 opcode = 177 target = 2 parameter1 = race parameter2 = 4 timing = 1 probability1 = prob       STR_VAR resource = EVAL ~%SOURCE_RES%3~ END // ranged quadruple
    LPF ADD_ITEM_EFFECT INT_VAR type = 2 opcode = 177 target = 2 parameter1 = race parameter2 = 4 timing = 1 probability2 = (1 + prob) STR_VAR resource = EVAL ~%SOURCE_RES%2~ END // ranged double
  END  
  SET prob += 15

/////                                                  \\\\\
///// item placement                                   \\\\\
/////                                                  \\\\\

// javelins below +2 are scattered into loot and stores

ACTION_IF game_is_iwdee BEGIN // iwdee

  EXTEND_BOTTOM ~ar5404.bcs~ ~cd_project_javelin/baf/ar5404.baf~ // add iron elegy to top of sheverash tower
  
  COPY_EXISTING ~ldd_nym.sto~ ~override~ // add +3 returning to nym
    LPF ADD_STORE_ITEM_EX STR_VAR item_name = cdjav3 position = EVAL "AFTER moradin" flags = identified END
    BUT_ONLY

END

ACTION_IF game_includes_bg1 BEGIN // bgee, eet, bgt, tutu

  // add returning +2 javelin to genthore at the cloakwood mine entrance by replacing throwing axes
  COPY_EXISTING ~%tutu_var%gentho.cre~ ~override~
    LPF DELETE_CRE_ITEM STR_VAR item_to_delete = EVAL ~%tutu_var%ax1h04~ END
    ADD_CRE_ITEM ~cdjav2~ #0 #0 #0 ~NONE~ ~weapon~
    LPF cd_transfer_profs INT_VAR old_bg1 = 0x74 old_bg2 = 92 new_bg1 = 0x71 new_bg2 = 98 END // any prof with axe, set to spear (if lower)
    BUT_ONLY

